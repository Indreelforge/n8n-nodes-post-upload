{
	"name": "n8n-nodes-post-upload",
	"version": "1.4.0",
	"description": "n8n community node for Post-Upload: publish videos, photos and text to 16 social networks in one step, then schedule, track and analyse your posts.",
	"license": "MIT",
	"homepage": "https://docs.post-upload.com/guides/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"post-upload",
		"social-media",
		"instagram",
		"tiktok",
		"youtube",
		"linkedin",
		"discord",
		"telegram",
		"slack",
		"mastodon",
		"wordpress",
		"automation"
	],
	"author": {
		"name": "Post-Upload",
		"email": "n8n@post-upload.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Indreelforge/n8n-nodes-post-upload.git"
	},
	"bugs": {
		"url": "https://github.com/Indreelforge/n8n-nodes-post-upload/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PostUploadApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PostUpload/PostUpload.node.js",
			"dist/nodes/PostUploadTrigger/PostUploadTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
